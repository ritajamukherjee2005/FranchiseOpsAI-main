// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  REGIONAL_MANAGER
  OUTLET_MANAGER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  FLEXIBLE
}

enum CampaignType {
  ONLINE
  SOCIAL_MEDIA
  IN_STORE
  LOYALTY
  SEASONAL
  EMAIL
  PARTNERSHIP
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  UPCOMING
}

enum AuditType {
  OPERATIONAL
  HYGIENE
  SAFETY
  COMPLIANCE
  INVENTORY
}

enum AuditStatus {
  COMPLETED
  PENDING
  FAILED
  IN_PROGRESS
}

enum ChecklistStatus {
  PASS
  FAIL
  PARTIAL
  NOT_APPLICABLE
}

enum AlertType {
  INVENTORY
  SALES
  STAFF
  AUDIT
  MARKETING
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Franchise {
  id        String   @id @default(cuid())
  name      String
  city      String
  state     String
  region    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff              Staff[]
  users              User[]
  marketingCampaigns MarketingCampaign[]
  audits             Audit[]
  alerts             Alert[]

  @@map("franchises")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  fullName    String
  role        UserRole @default(OUTLET_MANAGER)
  region      String?
  franchiseId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  franchise Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Staff {
  id             String      @id @default(cuid())
  staffId        String      @unique
  name           String
  email          String      @unique
  phone          String
  department     String
  designation    String
  salary         Decimal     @db.Decimal(12, 2)
  shift          ShiftType   @default(MORNING)
  attendanceRate Float       @default(100)
  joiningDate    DateTime
  status         StaffStatus @default(ACTIVE)
  franchiseId    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  franchise   Franchise          @relation(fields: [franchiseId], references: [id], onDelete: Restrict)
  attendances AttendanceRecord[]

  @@index([franchiseId])
  @@index([status])
  @@index([department])
  @@map("staff")
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  staffId   String
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  checkIn   String?
  checkOut  String?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([date])
  @@map("attendance_records")
}

model RetailTransaction {
  id              String   @id @default(cuid())
  billId          Int      @unique
  customerName    String
  city            String
  productCategory String
  quantity        Int
  totalAmount     Decimal  @db.Decimal(12, 2)
  paymentMethod   String
  storeType       String
  visitDate       DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([city])
  @@index([storeType])
  @@index([visitDate])
  @@map("retail_transactions")
}

model MarketingCampaign {
  id               String         @id @default(cuid())
  name             String
  type             CampaignType   @default(ONLINE)
  outletName       String
  city             String?
  targetAudience   String?
  productCategory  String?
  franchiseId      String?
  startDate        DateTime       @db.Date
  endDate          DateTime       @db.Date
  budget           Decimal        @db.Decimal(12, 2)
  revenueGenerated Decimal        @db.Decimal(12, 2)
  customersReached Int            @default(0)
  clicks           Int?           @default(0)
  conversions      Int            @default(0)
  status           CampaignStatus @default(ACTIVE)
  description      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  franchise Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)

  @@index([franchiseId])
  @@index([status])
  @@index([type])
  @@map("marketing_campaigns")
}

model Audit {
  id                   String      @id @default(cuid())
  auditCode            String      @unique
  outletName           String
  city                 String?
  auditorName          String
  auditorId            String?
  auditDate            DateTime    @db.Date
  auditType            AuditType   @default(OPERATIONAL)
  status               AuditStatus @default(PENDING)
  score                Float       @default(0)
  compliancePercentage Float       @default(0)
  remarks              String?
  franchiseId          String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  franchise Franchise?           @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  items     AuditChecklistItem[]

  @@index([franchiseId])
  @@index([status])
  @@index([auditType])
  @@map("audits")
}

model AuditChecklistItem {
  id        String          @id @default(cuid())
  auditId   String
  category  String
  question  String
  status    ChecklistStatus @default(PASS)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@map("audit_checklist_items")
}

model Alert {
  id          String        @id @default(cuid())
  type        AlertType     @default(INVENTORY)
  severity    AlertSeverity @default(INFO)
  title       String
  message     String
  outletName  String?
  franchiseId String?
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  franchise Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)

  @@index([franchiseId])
  @@index([severity])
  @@index([type])
  @@map("alerts")
}
